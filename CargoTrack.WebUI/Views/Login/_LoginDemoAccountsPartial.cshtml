<div class="mt-6 pt-5 border-t border-[#1e2f58]/60">
    <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
            <span class="material-symbols-outlined text-cyan-400 text-base" style="font-variation-settings: 'FILL' 1;">terminal</span>
            <span class="tracking-wider">DEMO HESAPLAR</span>
        </div>
        <span class="text-[11px] text-cyan-400/90 font-mono tracking-tight bg-cyan-950/50 border border-cyan-800/40 px-2 py-0.5 rounded">
            ⚡ 1-TIKLA DOLDUR
        </span>
    </div>

    <div class="grid grid-cols-3 gap-2">
        <!-- Admin -->
        <button type="button" 
                onclick="fillDemo('nerimanaslan', 'Neriman123*')"
                class="group text-left p-2.5 rounded-xl bg-[#060b17] border border-[#1e2f58] hover:border-amber-500/60 hover:bg-[#0d1b30] transition-all duration-200">
            <div class="flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span class="text-[11px] font-bold text-amber-300 group-hover:text-amber-200">Admin</span>
            </div>
            <div class="font-mono text-[11px] text-slate-300 truncate">nerimanaslan</div>
            <div class="font-mono text-[10px] text-slate-500">Neriman123*</div>
        </button>

        <!-- Manager -->
        <button type="button" 
                onclick="fillDemo('manager', '123456')"
                class="group text-left p-2.5 rounded-xl bg-[#060b17] border border-[#1e2f58] hover:border-cyan-500/60 hover:bg-[#0d1b30] transition-all duration-200">
            <div class="flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                <span class="text-[11px] font-bold text-cyan-300 group-hover:text-cyan-200">Şube Müdürü</span>
            </div>
            <div class="font-mono text-[11px] text-slate-300 truncate">manager</div>
            <div class="font-mono text-[10px] text-slate-500">123456</div>
        </button>

        <!-- Müşteri -->
        <button type="button" 
                onclick="fillDemo('ali01', 'Ali1234*')"
                class="group text-left p-2.5 rounded-xl bg-[#060b17] border border-[#1e2f58] hover:border-emerald-500/60 hover:bg-[#0d1b30] transition-all duration-200">
            <div class="flex items-center gap-1.5 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span class="text-[11px] font-bold text-emerald-300 group-hover:text-emerald-200">Müşteri</span>
            </div>
            <div class="font-mono text-[11px] text-slate-300 truncate">ali01</div>
            <div class="font-mono text-[10px] text-slate-500">Ali1234*</div>

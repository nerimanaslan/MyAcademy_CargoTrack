<div class="bg-[#0d1527] rounded-2xl shadow-xl border border-[#1e2f58] p-6 md:p-8 max-w-3xl mx-auto mb-section-padding relative overflow-hidden">
    <div class="absolute -right-16 -top-16 opacity-5 pointer-events-none">
        <span class="material-symbols-outlined text-[200px] text-cyan-400">local_shipping</span>
    </div>
    <div class="flex items-center gap-3 mb-6 relative z-10">
        <div class="w-12 h-12 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-cyan-400">
            <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <h2 class="font-headline-md text-headline-md text-white font-bold">Kargo Takip Numarası</h2>
    </div>

    <form class="flex flex-col md:flex-row gap-4 relative z-10" asp-action="CargoDetails" asp-controller="Default" method="get">
        <input name="trackCode" class="flex-grow border border-[#1e2f58] rounded-lg px-4 py-3 font-mono text-white focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-500/30 transition bg-[#060b17] placeholder:text-slate-500 h-[48px]" placeholder="Örn: MYC-2026-XXXXXX" type="text" required />
        <button class="bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-3 rounded-lg font-bold flex items-center justify-center gap-2 transition h-[48px] whitespace-nowrap shadow-lg shadow-emerald-900/30 active:scale-95" type="submit">
            <span class="material-symbols-outlined text-sm font-bold">search</span>
            Gönderiyi Sorgula
        </button>
    </form>

    @if (ViewBag.error != null)
    {
        <div class="mt-4 p-4 rounded-lg bg-[#2d111b] border border-rose-500 text-rose-200 text-sm flex items-center gap-2 relative z-10">
            <span class="material-symbols-outlined text-rose-400">error</span>
            <span>@ViewBag.error</span>
        </div>
    }
</div>
@model List<CargoTrack.DTO.DTOs.Cargos.PublicRecentShipmentDto>

<h3 class="font-headline-md text-headline-md text-on-background mb-stack-md">Son Sorgulanan Gönderiler</h3>
<div class="flex flex-col gap-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <a href="/Default/CargoDetails?trackCode=@item.TrackCode" class="bg-white rounded-lg border border-outline-variant p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:shadow-md transition-shadow group cursor-pointer border-l-4 @item.BorderColorClass">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="font-body-md text-body-md font-bold text-on-background group-hover:text-primary transition-colors">@item.TrackCode</span>
                        <span class="@item.StatusBadgeClass px-2 py-1 rounded-full font-status-label text-status-label flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">@item.StatusIcon</span>
                            @item.StatusText
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
                        <span>@item.OriginCity</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        <span>@item.DestinationCity</span>
                    </div>
                </div>
                <div class="text-right md:text-right text-left w-full md:w-auto mt-2 md:mt-0 pt-4 md:pt-0 border-t border-outline-variant md:border-none">
                    <div class="text-on-surface-variant text-sm mb-1">@item.DateLabel</div>
                    <div class="flex items-center md:justify-end gap-1 font-body-md text-body-md font-bold text-on-background">
                        <span class="material-symbols-outlined text-sm">calendar_month</span>
                        @item.DateFormatted
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <div class="bg-white p-6 rounded-lg border border-outline-variant text-center text-gray-500">
            Henüz son sorgulanan bir gönderi bulunmamaktadır.
        </div>
    }
</div>
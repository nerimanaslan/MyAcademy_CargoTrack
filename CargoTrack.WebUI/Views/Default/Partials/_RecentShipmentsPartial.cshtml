@model List<CargoTrack.DTO.DTOs.Cargos.PublicRecentShipmentDto>

<h3 class="font-headline-md text-headline-md text-white font-bold mb-4">Son Sorgulanan Gönderiler</h3>
<div class="flex flex-col gap-3">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <a href="/Default/CargoDetails?trackCode=@item.TrackCode" class="bg-[#0d1527] hover:bg-[#121c33] rounded-xl border border-[#1e2f58] p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:border-cyan-500/50 shadow-lg transition group cursor-pointer border-l-4 @item.BorderColorClass">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="font-mono text-[15px] font-bold text-cyan-300 group-hover:text-cyan-200 transition-colors">@item.TrackCode</span>
                        <span class="@item.StatusBadgeClass px-2.5 py-1 rounded-full text-xs font-semibold flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">@item.StatusIcon</span>
                            @item.StatusText
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-300 text-sm">
                        <span class="text-white font-medium">@item.OriginCity</span>
                        <span class="material-symbols-outlined text-sm text-cyan-400">arrow_forward</span>
                        <span class="text-amber-300 font-medium">@item.DestinationCity</span>
                    </div>
                </div>
                <div class="text-right md:text-right text-left w-full md:w-auto mt-2 md:mt-0 pt-3 md:pt-0 border-t border-[#1e2f58] md:border-none">
                    <div class="text-slate-400 text-xs mb-1">@item.DateLabel</div>
                    <div class="flex items-center md:justify-end gap-1 text-sm font-semibold text-slate-200 font-mono">
                        <span class="material-symbols-outlined text-sm text-slate-400">calendar_month</span>
                        @item.DateFormatted
                    </div>
                </div>
            </a>
        }
    }
    else
    {
        <div class="bg-[#0d1527] p-8 rounded-xl border border-[#1e2f58] text-center text-slate-400">
            Henüz son sorgulanan bir gönderi bulunmamaktadır.
        </div>
    }
</div>
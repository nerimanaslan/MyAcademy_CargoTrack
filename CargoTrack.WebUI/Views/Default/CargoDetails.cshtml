@model CargoTrack.DTO.DTOs.Cargos.PublicCargoTrackingDto
@{
    ViewData["Title"] = "Gönderi Detayları - " + Model.TrackCode;
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="max-w-container-max-width mx-auto px-gutter py-8 md:py-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-white font-bold mb-2">Gönderi Detayları</h1>
            <p class="text-slate-400 font-body-md">Gönderinizin güncel durumunu ve operasyonel hareket geçmişini inceleyin.</p>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <button onclick="window.print()" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-[#111b33] text-slate-200 border border-[#1e2f58] px-4 py-2.5 rounded-lg font-semibold hover:bg-[#162343] transition-colors">
                <span class="material-symbols-outlined">print</span>
                Kargo Detayını Yazdır
            </button>
            <a href="/Default/Index" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-secondary-container text-on-secondary px-6 py-2.5 rounded-lg font-semibold hover:bg-opacity-90 transition-colors shadow-sm">
                <span class="material-symbols-outlined">search</span>
                Yeni Kargo Sorgula
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Column (Main Info) -->
        <div class="lg:col-span-8 flex flex-col gap-6">
            <!-- Main Tracking Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col md:flex-row gap-8">
                <!-- Basic Info -->
                <div class="flex-1 border-r-0 md:border-r border-outline-variant/30 pr-0 md:pr-6">
                    <div class="mb-4">
                        <p class="font-label-caps text-label-caps text-slate-400 mb-1 uppercase">Takip Numarası</p>
                        <h2 class="font-headline-md text-headline-md text-cyan-300 font-mono font-bold tracking-wider">@Model.TrackCode</h2>
                    </div>
                    <div class="inline-flex items-center gap-1.5 @Model.StatusBadgeClass px-3 py-1 rounded-full font-status-label text-status-label mb-6">
                        <span class="material-symbols-outlined text-[16px]">@Model.StatusIcon</span>
                        @Model.StatusName
                    </div>
                    <div class="flex gap-8">
                        <div>
                            <p class="text-sm text-slate-400 mb-1">Gönderim Tarihi</p>
                            <p class="font-semibold text-white">@Model.ShipmentDateFormatted</p>
                        </div>
                        <div>
                            <p class="text-sm text-slate-400 mb-1">Tahmini Varış</p>
                            <p class="font-semibold text-white">@Model.EstimatedDeliveryFormatted</p>
                        </div>
                    </div>
                </div>

                <!-- Journey Graphic -->
                <div class="flex-1 flex flex-col justify-center">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 rounded-full bg-blue-600/20 border border-blue-500/30 flex items-center justify-center mb-2 text-cyan-400">
                                <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">location_on</span>
                            </div>
                            <span class="font-semibold text-white">@Model.OriginCity</span>
                            <span class="text-xs text-outline">@Model.OriginDistrict</span>
                        </div>
                        <div class="flex-grow flex items-center px-2">
                            <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                            <div class="flex-grow h-px bg-outline-variant relative">
                                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-lowest px-2">
                                    <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                                </div>
                            </div>
                            <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                        </div>
                        <div class="flex flex-col items-center">
                            <div class="w-8 h-8 rounded-full bg-surface-container text-outline flex items-center justify-center mb-2">
                                <span class="material-symbols-outlined text-[18px]">flag</span>
                            </div>
                            <span class="font-semibold text-on-background">@Model.DestinationCity</span>
                            <span class="text-xs text-outline">@Model.DestinationDistrict</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sender / Receiver Cards (KVKK Protected) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Gönderici (Gizlenmiş)</p>
                        <p class="font-semibold text-on-background">@Model.MaskedSenderName</p>
                        <p class="text-sm text-on-surface-variant">@Model.SenderLocation</p>
                    </div>
                </div>
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Alıcı (Gizlenmiş)</p>
                        <p class="font-semibold text-on-background">@Model.MaskedReceiverName</p>
                        <p class="text-sm text-on-surface-variant">@Model.ReceiverLocation</p>
                    </div>
                </div>
            </div>

            <!-- Package Details -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">
                <h3 class="font-headline-md text-xl text-white font-bold mb-4">Kargo Bilgileri</h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-surface rounded-lg p-4">
                        <p class="text-sm text-outline mb-1">Ağırlık / Desi</p>
                        <p class="font-semibold text-on-background">@Model.WeightFormatted</p>
                    </div>
                    <div class="bg-surface rounded-lg p-4">
                        <p class="text-sm text-outline mb-1">Gönderi Tipi</p>
                        <p class="font-semibold text-on-background">@Model.CargoTypeDescription</p>
                    </div>
                    <div class="bg-surface rounded-lg p-4">
                        <p class="text-sm text-outline mb-1">Çıkış Şubesi</p>
                        <p class="font-semibold text-on-background">@Model.OriginBranchName</p>
                    </div>
                    <div class="bg-surface rounded-lg p-4">
                        <p class="text-sm text-outline mb-1">Varış Şubesi</p>
                        <p class="font-semibold text-on-background">@Model.DestinationBranchName</p>
                    </div>
                </div>
            </div>

            <!-- Estimated Delivery Banner -->
            <div class="bg-primary-container rounded-xl shadow-sm p-6 text-on-primary">
                <div class="flex items-center gap-3 mb-2">
                    <span class="material-symbols-outlined text-[28px]">schedule</span>
                    <h3 class="font-headline-md text-2xl font-bold">@Model.EstimatedDeliveryTitle</h3>
                </div>
                <p class="text-primary-fixed-dim mb-6 ml-10">Planlanan Saat Aralığı: @Model.EstimatedTimeWindow</p>
                <div class="relative w-full h-3 progress-bar-bg rounded-full overflow-hidden mb-2">
                    <div class="absolute top-0 left-0 h-full progress-bar-fill rounded-full" style="width: @(Model.ProgressPercentage)%;"></div>
                </div>
                <div class="flex justify-between text-xs text-primary-fixed-dim">
                    <span>Gönderi Kabul</span>
                    <span>Transfer & Dağıtım</span>
                    <span>Teslimat</span>
                </div>
            </div>
        </div>

        <!-- Right Column (Timeline) -->
        <div class="lg:col-span-4">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 h-full flex flex-col">
                <div class="flex items-center justify-between gap-2 mb-6 pb-4 border-b border-outline-variant/30">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-cyan-400">history</span>
                        <h3 class="font-headline-md text-xl text-white font-bold">Kargo Hareketleri</h3>
                    </div>
                    <span class="text-xs bg-[#162343] text-cyan-300 font-mono px-2 py-1 rounded border border-[#1e2f58]">@Model.Movements.Count İşlem</span>
                </div>

                <div class="relative flex-grow">
                    @if (Model.Movements != null && Model.Movements.Any())
                    {
                        @for (int i = 0; i < Model.Movements.Count; i++)
                        {
                            var item = Model.Movements[i];
                            bool isLast = i == Model.Movements.Count - 1;

                            <div class="timeline-item relative @(isLast ? "" : "pb-8") pl-10">
                                @if (!isLast)
                                {
                                    <div class="timeline-line"></div>
                                }
                                <div class="absolute left-0 top-0 w-6 h-6 rounded-full @item.CircleColorClass flex items-center justify-center z-10 ring-4 ring-[#0d1527]">
                                    <span class="material-symbols-outlined text-[14px] font-bold">@item.IconName</span>
                                </div>
                                <p class="font-semibold text-on-background mb-1">@item.Title</p>
                                <div class="flex items-center gap-1 text-sm text-outline">
                                    <span class="material-symbols-outlined text-[16px]">location_on</span>
                                    <span>@item.Location • @item.DateFormatted, @item.TimeFormatted</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-gray-500">Henüz kargo hareketi kaydedilmedi.</p>
                    }
                </div>

                <!-- Barcode Representation -->
                <div class="mt-8 pt-4 border-t border-outline-variant/20 text-center">
                    <p class="text-xs text-gray-400 mb-2">KARGO ETİKET BARKODU</p>
                    <div class="inline-block bg-[#060b17] p-2 border border-[#1e2f58] rounded-lg font-mono text-sm tracking-widest font-bold text-cyan-300">
                        ||||| | |||| ||| |||| | ||| || ||||
                        <div class="text-xs mt-1 text-slate-400">@Model.TrackCode</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

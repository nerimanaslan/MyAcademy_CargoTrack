@using Microsoft.AspNetCore.Identity
@using CargoTrack.Entity.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - CargoTrack</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-container-high": "#dce9ff",
                        "tertiary-container": "#171e24",
                        "tertiary-fixed": "#dce3eb",
                        "on-surface-variant": "#43474e",
                        "on-secondary-container": "#603100",
                        "outline": "#74777e",
                        "secondary-fixed": "#ffdcc3",
                        "secondary": "#904d00",
                        "background": "#f8f9ff",
                        "inverse-on-surface": "#eaf1ff",
                        "error": "#ba1a1a",
                        "on-background": "#0b1c30",
                        "on-tertiary-fixed-variant": "#40484e",
                        "on-primary-fixed-variant": "#2f4868",
                        "surface-bright": "#f8f9ff",
                        "primary-fixed-dim": "#afc8ee",
                        "primary-fixed": "#d3e3ff",
                        "on-secondary-fixed": "#2f1500",
                        "primary-container": "#001e3c",
                        "surface-container-highest": "#d3e4fe",
                        "on-primary-fixed": "#001c39",
                        "primary": "#00040c",
                        "on-primary": "#ffffff",
                        "secondary-fixed-dim": "#ffb77d",
                        "surface-variant": "#d3e4fe",
                        "surface-dim": "#cbdbf5",
                        "error-container": "#ffdad6",
                        "on-tertiary-container": "#7f868d",
                        "on-secondary-fixed-variant": "#6e3900",
                        "outline-variant": "#c4c6ce",
                        "surface-container": "#e5eeff",
                        "inverse-surface": "#213145",
                        "on-primary-container": "#6f87aa",
                        "tertiary-fixed-dim": "#c0c7cf",
                        "on-tertiary-fixed": "#151c22",
                        "on-surface": "#0b1c30",
                        "on-tertiary": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "inverse-primary": "#afc8ee",
                        "on-error-container": "#93000a",
                        "surface-tint": "#486081",
                        "surface-container-lowest": "#ffffff",
                        "on-error": "#ffffff",
                        "surface": "#f8f9ff",
                        "tertiary": "#000307",
                        "secondary-container": "#fd8b00",
                        "on-secondary": "#ffffff"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "section-padding": "4rem",
                        "container-max-width": "1200px",
                        "stack-sm": "0.5rem",
                        "stack-md": "1rem",
                        "stack-lg": "2rem",
                        "gutter": "1.5rem",
                        "margin-mobile": "1rem"
                    },
                    fontFamily: {
                        "status-label": ["Hanken Grotesk"],
                        "body-lg": ["Hanken Grotesk"],
                        "headline-lg-mobile": ["Hanken Grotesk"],
                        "headline-md": ["Hanken Grotesk"],
                        "headline-lg": ["Hanken Grotesk"],
                        "body-md": ["Hanken Grotesk"],
                        "headline-xl": ["Hanken Grotesk"],
                        "label-caps": ["Hanken Grotesk"]
                    },
                    fontSize: {
                        "status-label": ["13px", { "lineHeight": "18px", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["28px", { "lineHeight": "36px", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "700" }]
                    }
                }
            }
        };
    </script>
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8f9ff; color: #0b1c30; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .filled-icon { font-variation-settings: 'FILL' 1; }
        .timeline-line::before {
            content: '';
            position: absolute;
            left: 11px;
            top: 24px;
            bottom: -24px;
            width: 2px;
            background-color: #E2E8F0;
            z-index: 0;
        }
        .timeline-item:last-child .timeline-line::before { display: none; }
        .progress-bar-bg { background-color: #334155; }
        .progress-bar-fill { background-color: #fd8b00; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <!-- TopNavBar -->
    <nav class="bg-surface dark:bg-primary-container font-body-md text-body-md docked full-width top-0 border-b border-outline-variant dark:border-on-primary-container shadow-sm z-50">
        <div class="flex justify-between items-center px-gutter py-4 max-w-container-max-width mx-auto">
            <a href="/Default/Index" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary dark:text-primary-fixed text-3xl" style="font-variation-settings: 'FILL' 1;">package_2</span>
                <span class="font-headline-md text-headline-md font-bold text-on-background dark:text-surface-bright">CargoTrack</span>
            </a>
            <div class="hidden md:flex gap-6 items-center">
                <a class="text-secondary dark:text-secondary-fixed-dim font-bold border-b-2 border-secondary pb-1" href="/Default/Index">Ana Sayfa</a>
                <a class="text-on-surface-variant dark:text-on-primary-container hover:text-primary dark:hover:text-primary-fixed hover:bg-surface-container-low dark:hover:bg-tertiary-container transition-colors px-2 py-1 rounded" href="/Default/Index">Kargo Takip</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="text-blue-700 font-bold hover:underline px-2 py-1 rounded" href="/Admin/Dashboard/Index">Admin Paneli</a>
                }
                else if (User.IsInRole("Manager"))
                {
                    <a class="text-blue-700 font-bold hover:underline px-2 py-1 rounded" href="/Manager/Dashboard/Index">Şube Paneli</a>
                }
                else if (User.IsInRole("User"))
                {
                    <a class="text-blue-700 font-bold hover:underline px-2 py-1 rounded" href="/User/Dashboard/Index">Kargo Takip Panelim</a>
                }
            </div>
            <div class="flex items-center gap-3">
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold text-gray-700">@User.Identity?.Name</span>
                        <a href="/Login/Logout" class="bg-gray-100 text-gray-700 hover:bg-gray-200 px-3 py-1.5 rounded text-sm font-medium transition-colors">
                            Çıkış
                        </a>
                    </div>
                }
                else
                {
                    <a href="/Login/Index" class="text-on-surface-variant hover:text-primary font-semibold text-sm px-3 py-2 rounded">
                        Giriş Yap
                    </a>
                    <a href="/Register/Signup" class="text-primary hover:underline font-semibold text-sm px-2 py-2">
                        Kayıt Ol
                    </a>
                }

                <a href="/User/Shipment/SendCargo" class="bg-primary-container text-on-primary px-5 py-2.5 rounded-DEFAULT font-semibold flex items-center gap-2 scale-95 active:opacity-80 transition-transform hover:bg-primary shadow-sm">
                    <span class="material-symbols-outlined text-sm">send</span>
                    Kargo Gönder
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-primary-container dark:bg-primary font-body-md text-body-md full-width bottom flex flex-col md:flex-row justify-between items-center px-gutter py-8 w-full mt-auto">
        <div class="text-surface-bright font-body-md text-body-md mb-4 md:mb-0 opacity-90 max-w-container-max-width mx-auto flex flex-col md:flex-row justify-between items-center w-full gap-4">
            <div>
                © 2026 CargoTrack Lojistik A.Ş. Tüm hakları saklıdır.
            </div>
            <div class="flex flex-wrap gap-4 md:gap-6 justify-center">
                <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">Gizlilik Politikası</a>
                <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">Kullanım Şartları</a>
                <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">KVKK Aydınlatma Metni</a>
                <a class="text-on-primary-container dark:text-primary-fixed-dim opacity-80 hover:opacity-100 hover:text-secondary-container dark:hover:text-secondary-fixed transition-colors" href="#">Sıkça Sorulan Sorular</a>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model CargoTrack.DTO.DTOs.UserDtos.RegisterUserDto
@{
    Layout = null; // Kayıt ekranı tam sayfa olacağı için genel Layout'u devre dışı bıraktık
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - CargoTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9ff;
        }

        .register-card {
            max-width: 500px;
            border-radius: 1rem;
            border: 1px solid #dce3eb;
        }

        .form-control:focus {
            border-color: #001e3c;
            box-shadow: 0 0 0 0.25rem rgba(0, 30, 60, 0.1);
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 py-5">

    <div class="container d-flex justify-content-center">
        <div class="card register-card shadow-sm w-100 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <span class="material-symbols-outlined fs-2">person_add</span>
                </div>
                <h2 class="fw-bold text-dark mb-1">Hesap Oluştur</h2>
                <p class="text-muted small">Kargolarınızı yönetmek için hemen kayıt olun.</p>
            </div>

            <form asp-action="Signup" asp-controller="Register" method="post">
                <!-- Hata Mesajları -->
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold mb-1">Adınız</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Örn: Ahmet" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold mb-1">Soyadınız</label>
                        <input asp-for="LastName" class="form-control" placeholder="Örn: Yılmaz" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold mb-1">Kullanıcı Adı</label>
                    <input asp-for="UserName" class="form-control" placeholder="Örn: ahmetyilmaz" required />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold mb-1">E-Posta Adresi</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Örn: ahmet@example.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold mb-1">Şifre</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="En az 6 karakter" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold mb-1">Şifre Tekrar</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Şifrenizi tekrar girin" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3" style="background-color: #001e3c; border-color: #001e3c;">
                    Kayıt Ol
                </button>

                <div class="text-center text-muted small">
                    Zaten bir hesabınız var mı? <a href="/Login/Index" class="text-decoration-none fw-semibold" style="color: #001e3c;">Giriş Yap</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
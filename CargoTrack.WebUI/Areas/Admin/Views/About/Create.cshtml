@model CreateAboutDto
@{
    ViewData["Title"] = "Yeni Hakkımızda Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Yeni Hakkımızda İçeriği</h2>
        <p class="text-muted small mb-0">Kurumsal tanıtım ve hakkımızda kartı ekleyin</p>
    </div>
    <a href="/Admin/About/Index" class="btn btn-outline-secondary d-flex align-items-center gap-1">
        <span class="material-symbols-outlined fs-6">arrow_back</span>
        İçerik Listesine Dön
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-stat bg-white p-4 shadow-sm">
            <h5 class="fw-bold mb-3 border-bottom pb-2 d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-info">article</span>
                İçerik Bilgileri
            </h5>

            <form asp-area="Admin" asp-controller="About" asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Başlık</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Vizyonumuz & Misyonumuz" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Açıklama metnini giriniz..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">Görsel URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" required />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a href="/Admin/About/Index" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1">
                        <span class="material-symbols-outlined fs-6">save</span>
                        İçeriği Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

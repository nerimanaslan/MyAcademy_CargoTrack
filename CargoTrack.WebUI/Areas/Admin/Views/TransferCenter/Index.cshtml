@model List<ResultTransferCenterDto>
@{
    ViewData["Title"] = "Transfer Merkezleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Transfer Merkezleri (Hubs)</h2>
        <p class="text-muted small mb-0">Şubeler arası aktarma ve lojistik tasnif merkezleri</p>
    </div>
    <a href="/Admin/TransferCenter/Create" class="btn btn-primary d-flex align-items-center gap-1">
        <span class="material-symbols-outlined">add</span>
        Yeni Transfer Merkezi Ekle
    </a>
</div>

<div class="card card-stat bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Kod</th>
                    <th>Merkez Adı</th>
                    <th>Bulunduğu Şehir</th>
                    <th>Günlük Kapasite</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int count = 0;
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td><span class="badge bg-dark font-monospace">@item.Code</span></td>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.CityName</td>
                            <td>@item.DailyCapacity.ToString("N0") kargo/gün</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="/Admin/TransferCenter/Update/@item.Id" class="btn btn-sm btn-outline-info">Düzenle</a>
                                <a href="/Admin/TransferCenter/Delete/@item.Id" onclick="return confirm('Bu transfer merkezini silmek istediğinize emin misiniz?')" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Kayıtlı transfer merkezi bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

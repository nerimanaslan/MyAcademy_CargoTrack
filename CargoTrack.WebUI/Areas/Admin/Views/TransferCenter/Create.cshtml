@model CreateTransferCenterDto
@{
    ViewData["Title"] = "Yeni Transfer Merkezi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Yeni Transfer Merkezi</h2>
        <p class="text-muted small mb-0">Bölgesel transfer ve aktarma merkezi tanımlayın.</p>
    </div>
    <a href="/Admin/TransferCenter/Index" class="btn btn-outline-secondary">&larr; Listeye Dön</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-stat bg-white p-4">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Transfer Merkezi Adı</label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: İstanbul Anadolu Transfer Merkezi" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Code" class="form-label fw-semibold">Merkez Kodu</label>
                    <input asp-for="Code" class="form-control" placeholder="Örn: TM-IST-01" required />
                </div>
                <div class="mb-3">
                    <label asp-for="CityId" class="form-label fw-semibold">Şehir</label>
                    <select asp-for="CityId" asp-items="ViewBag.Cities" class="form-select" required>
                        <option value="">-- Şehir Seçin --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="DailyCapacity" class="form-label fw-semibold">Günlük İşlem Kapasitesi</label>
                    <input asp-for="DailyCapacity" type="number" class="form-control" value="10000" />
                </div>
                <div class="mb-3">
                    <label asp-for="AddressDetail" class="form-label fw-semibold">Adres / Lokasyon Detayı</label>
                    <textarea asp-for="AddressDetail" class="form-control" rows="2"></textarea>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@using CargoTrack.DTO.DTOs.UserDtos
@model List<ResultUserDto>
@{
    ViewData["Title"] = "Kullanıcı Rol Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-0">Kullanıcı Rol Yönetimi</h2>
            <span class="badge bg-primary-subtle text-info border border-info-subtle font-monospace px-2 py-1">@Model.Count KULLANICI</span>
        </div>
        <p class="text-muted small mt-1 mb-0">Sistem kullanıcılarının rolleri (Admin, Manager, User) ve yetki atamaları</p>
    </div>
</div>

<div class="card card-stat bg-white overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Ad Soyad</th>
                    <th>E-Posta</th>
                    <th>Kullanıcı Adı</th>
                    <th>Atanmış Roller</th>
                    <th class="text-end" style="width: 140px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    count++;
                    <tr>
                        <td class="font-monospace text-muted">@count</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined text-info" style="font-size: 20px;">person</span>
                                <span class="fw-semibold">@item.FullName</span>
                            </div>
                        </td>
                        <td class="text-muted">@item.Email</td>
                        <td class="font-monospace text-info">@@@item.UserName</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (item.Roles != null && item.Roles.Any())
                                {
                                    @foreach (var role in item.Roles)
                                    {
                                        <span class="badge @(role == "Admin" ? "bg-danger" : role == "Manager" ? "bg-warning text-dark" : "bg-primary") px-2 py-1">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Rol Yok</span>
                                }
                            </div>
                        </td>
                        <td class="text-end">
                            <a href="/Admin/RoleAssign/AssignRole/@item.Id" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1">
                                <span class="material-symbols-outlined" style="font-size: 15px;">manage_accounts</span>
                                Rol Ata
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

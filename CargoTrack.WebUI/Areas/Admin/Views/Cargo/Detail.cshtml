@model CargoDetailDto
@{
    ViewData["Title"] = "Kargo Detayı - " + Model.TrackCode;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-0 font-monospace">@Model.TrackCode</h2>
            <span class="badge @(Model.CargoStatus == CargoStatus.Delivered ? "bg-success" : Model.CargoStatus == CargoStatus.OutForDelivery ? "bg-warning text-dark" : Model.CargoStatus == CargoStatus.DeliveryFailed ? "bg-danger" : Model.CargoStatus == CargoStatus.ReturnProcess ? "bg-dark" : "bg-primary") fs-6">
                @CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(Model.CargoStatus)
            </span>
            @if (Model.IsDelayed)
            {
                <span class="badge bg-danger fs-6">SLA Gecikmesi Var</span>
            }
        </div>
        <p class="text-muted small mt-1 mb-0">Gönderim Tarihi: @Model.ShipmentDate.ToString("dd.MM.yyyy HH:mm") | Tahmini Teslimat: <strong>@Model.EstimatedDeliveryDate.ToString("dd.MM.yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Default/CargoDetails?trackCode=@Model.TrackCode" target="_blank" class="btn btn-outline-primary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">open_in_new</span>
            Müşteri Takip Sayfası
        </a>
        <a href="/Admin/Cargo/Index" class="btn btn-outline-secondary">&larr; Listeye Dön</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Details & Operational Status Update -->
    <div class="col-lg-8">
        <!-- Summary Cards -->
        <div class="card card-stat bg-white p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Kargo ve Lojistik Bilgileri</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border">
                        <div class="text-muted small">Gönderici Bilgisi:</div>
                        <div class="fw-bold">@Model.SenderName</div>
                        <div class="small text-muted">@Model.SenderPhone | @Model.SenderEmail</div>
                        <div class="mt-2 text-primary small fw-semibold">Çıkış Şubesi: @Model.OriginBranchName (@Model.OriginCityName)</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border">
                        <div class="text-muted small">Alıcı Bilgisi:</div>
                        <div class="fw-bold">@Model.ReceiverName</div>
                        <div class="small text-muted">@Model.ReceiverPhone</div>
                        <div class="small text-muted mt-1">@Model.ReceiverAddress</div>
                        <div class="mt-2 text-primary small fw-semibold">Varış Şubesi: @Model.DestinationBranchName (@Model.DestinationCityName)</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-3">
                    <div class="small text-muted">Ağırlık:</div>
                    <div class="fw-bold">@Model.Weight kg</div>
                </div>
                <div class="col-3">
                    <div class="small text-muted">Boyutlar (E/B/Y):</div>
                    <div class="fw-bold">@Model.Width x @Model.Height x @Model.Length cm</div>
                </div>
                <div class="col-3">
                    <div class="small text-muted">Dinamik Desi:</div>
                    <div class="fw-bold text-primary">@Model.Desi desi</div>
                </div>
                <div class="col-3">
                    <div class="small text-muted">Hesaplanan Ücret:</div>
                    <div class="fw-bold text-success fs-5">@Model.Price.ToString("C2")</div>
                </div>
            </div>

            <!-- PIN Code and Delivery Security Info -->
            @if (!string.IsNullOrEmpty(Model.DeliveryPinCode))
            {
                <div class="mt-3 p-3 bg-warning bg-opacity-10 border border-warning rounded d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-warning text-dark me-2">6 Haneli Güvenlik Kodu</span>
                        <span class="fs-4 fw-bold font-monospace text-dark tracking-widest">@Model.DeliveryPinCode</span>
                    </div>
                    <div class="text-muted small">Alıcıya SMS ile iletilen teslimat onay şifresi</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ReceivedBy))
            {
                <div class="mt-3 p-3 bg-success bg-opacity-10 border border-success rounded">
                    <span class="badge bg-success me-2">Teslim Edildi</span>
                    <span>Teslim Alan Kişi: <strong>@Model.ReceivedBy</strong> (Tarih: @Model.ArrivalDate?.ToString("dd.MM.yyyy HH:mm"))</span>
                </div>
            }

            @if (Model.FailedDeliveryAttempts > 0)
            {
                <div class="mt-3 p-3 bg-danger bg-opacity-10 border border-danger rounded">
                    <span class="badge bg-danger me-2">Başarısız Denemeler: @Model.FailedDeliveryAttempts / 3</span>
                    <span class="text-danger small">@(Model.FailedDeliveryAttempts >= 3 ? "3 başarısız deneme tamamlandı, kargo İade Sürecinde." : "3 başarısız denemeden sonra otomatik iade süreci başlar.")</span>
                </div>
            }
        </div>

        <!-- Operational Status Update Form -->
        <div class="card card-stat bg-white p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Durum Güncelle & Yeni Hareket Gir</h5>
            <form asp-action="UpdateStatus" method="post" class="row g-3">
                <input type="hidden" name="CargoId" value="@Model.Id" />
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Yeni Durum</label>
                    <select name="NewStatus" class="form-select" id="newStatusSelect" required>
                        @foreach (CargoStatus st in Enum.GetValues(typeof(CargoStatus)))
                        {
                            <option value="@st" selected="@(Model.CargoStatus == st ? "selected" : null)">
                                @CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(st)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">İşlem Konumu</label>
                    <input type="text" name="LocationName" class="form-control" value="@Model.CurrentLocationName" placeholder="Şube veya Transfer Merkezi Adı" required />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Açıklama</label>
                    <input type="text" name="Description" class="form-control" placeholder="Hareket açıklaması (boş bırakılırsa varsayılan atanır)" />
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined fs-6">sync</span>
                        Durumu Güncelle ve Hareketi Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Timeline & Exceptions -->
    <div class="col-lg-4">
        <!-- Movements Timeline -->
        <div class="card card-stat bg-white p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0">Hareket Geçmişi</h5>
                <span class="badge bg-secondary">@Model.Movements.Count Kayıt</span>
            </div>

            <div class="timeline">
                @if (Model.Movements != null && Model.Movements.Any())
                {
                    @foreach (var m in Model.Movements)
                    {
                        <div class="border-start border-3 border-primary ps-3 pb-3 position-relative">
                            <div class="small fw-bold text-dark">@m.Description</div>
                            <div class="text-muted" style="font-size: 11px;">
                                <span class="material-symbols-outlined align-middle" style="font-size: 13px;">location_on</span>
                                @m.LocationName • @m.Timestamp.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small">Henüz hareket kaydı yok.</p>
                }
            </div>
        </div>

        <!-- Delivery Exceptions List -->
        @if (Model.Exceptions != null && Model.Exceptions.Any())
        {
            <div class="card card-stat bg-white p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-danger">Teslimat Sorunları / İstisnalar</h5>
                <div class="list-group list-group-flush">
                    @foreach (var ex in Model.Exceptions)
                    {
                        <div class="list-group-item px-0">
                            <div class="d-flex justify-content-between">
                                <strong class="text-danger small">Deneme #@ex.AttemptNumber: @ex.Reason</strong>
                                <span class="text-muted" style="font-size: 11px;">@ex.ExceptionDate.ToString("dd.MM.yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(ex.Notes))
                            {
                                <div class="text-muted small mt-1">@ex.Notes</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@model CreateEmployeeDto
@{
    ViewData["Title"] = "Yeni Personel Ekle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Yeni Personel Ekle</h2>
        <p class="text-muted small mb-0">Şube veya aktarma merkezine personel tanımlayın.</p>
    </div>
    <a href="/Admin/Employee/Index" class="btn btn-outline-secondary">&larr; Listeye Dön</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-stat bg-white p-4">
            <form asp-action="Create" method="post">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold">Ad</label>
                        <input asp-for="FirstName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold">Soyad</label>
                        <input asp-for="LastName" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Ünvan / Görev</label>
                    <select asp-for="Title" class="form-select" required>
                        <option value="Dağıtım Kuryesi">Dağıtım Kuryesi</option>
                        <option value="Şube Müdürü">Şube Müdürü</option>
                        <option value="Operasyon Görevlisi">Operasyon Görevlisi</option>
                        <option value="Aktarma Merkezi Sorumlusu">Aktarma Merkezi Sorumlusu</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="BranchId" class="form-label fw-semibold">Bağlı Olduğu Şube (Opsiyonel)</label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Şube Seçin --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="TransferCenterId" class="form-label fw-semibold">Bağlı Olduğu Transfer Merkezi (Opsiyonel)</label>
                    <select asp-for="TransferCenterId" asp-items="ViewBag.TransferCenters" class="form-select">
                        <option value="">-- Transfer Merkezi Seçin --</option>
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">Telefon</label>
                        <input asp-for="Phone" class="form-control" placeholder="05XXXXXXXXX" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">E-Posta</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Personeli Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@model AdminDashboardDto
@{
    ViewData["Title"] = "Genel Sistem Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Genel Sistem Dashboard</h2>
        <p class="text-muted small mb-0">Tüm kargo operasyonları, şube hacimleri ve anlık sistem istatistikleri</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/Cargo/Create" class="btn btn-primary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">add_circle</span>
            Yeni Kargo Kabul Et
        </a>
        <a href="/Admin/Report/Index" class="btn btn-outline-secondary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">insights</span>
            Performans Raporları
        </a>
    </div>
</div>

<partial name="Partials/_AdminKpiCardsPartial" model="Model" />

<partial name="Partials/_AdminChartsPartial" />

<div class="row g-4">
    <div class="col-lg-5">
        <partial name="Partials/_AdminTopBranchesPartial" model="Model.Top5Branches" />
    </div>
    <div class="col-lg-7">
        <partial name="Partials/_AdminRecentCargosPartial" model="Model.RecentCargos" />
    </div>
</div>

@section Scripts {
    <script>
        // 1. Traffic Chart (Son 7 Günlük Kargo Trafiği)
        const trafficCtx = document.getElementById('trafficChart').getContext('2d');
        new Chart(trafficCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrafficDays)),
                datasets: [{
                    label: 'Gönderi Sayısı',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrafficCounts)),
                    borderColor: '#06b6d4',
                    backgroundColor: 'rgba(6, 182, 212, 0.15)',
                    tension: 0.35,
                    fill: true,
                    pointRadius: 5,
                    pointBackgroundColor: '#38bdf8',
                    pointBorderColor: '#070b14',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        grid: { color: 'rgba(30, 47, 88, 0.5)' },
                        ticks: { color: '#94a3b8', font: { family: 'Inter', size: 11 } }
                    },
                    y: { 
                        beginAtZero: true, 
                        grid: { color: 'rgba(30, 47, 88, 0.5)' },
                        ticks: { color: '#94a3b8', stepSize: 1, font: { family: 'Inter', size: 11 } } 
                    }
                }
            }
        });

        // 2. Status Chart (Kargo Durum Dağılımı)
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusCounts)),
                    backgroundColor: ['#64748b', '#3b82f6', '#f59e0b', '#8b5cf6', '#eab308', '#10b981', '#f43f5e', '#ec4899', '#06b6d4'],
                    borderColor: '#0d1527',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { 
                        position: 'bottom', 
                        labels: { 
                            boxWidth: 12, 
                            color: '#cbd5e1', 
                            font: { family: 'Inter', size: 11 } 
                        } 
                    }
                }
            }
        });
    </script>
}

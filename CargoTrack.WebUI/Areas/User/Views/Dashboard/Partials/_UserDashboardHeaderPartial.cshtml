@model UserDashboardDto

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Hoş Geldiniz, @Model.UserFullName</h2>
        <p class="text-muted small mb-0">Adınıza gelen ve gönderdiğiniz tüm kargoların güncel hareketlerini buradan izleyebilirsiniz.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/User/Shipment/SendCargo" class="btn btn-primary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">send</span>
            Yeni Kargo Gönder
        </a>
        <a href="/User/Shipment/CalculatePrice" class="btn btn-outline-secondary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">calculate</span>
            Fiyat Hesapla
        </a>
    </div>
</div>

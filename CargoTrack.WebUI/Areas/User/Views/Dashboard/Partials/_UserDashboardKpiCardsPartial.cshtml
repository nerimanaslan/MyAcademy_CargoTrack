@model UserDashboardDto

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-stat p-3 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted fw-semibold">Yoldaki / Aktif Kargolarım</div>
                    <div class="fs-2 fw-bold text-warning mt-1">@Model.ActiveShipmentsCount</div>
                </div>
                <span class="material-symbols-outlined text-warning" style="font-size: 36px;">local_shipping</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat p-3 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted fw-semibold">Teslim Edilenler</div>
                    <div class="fs-2 fw-bold text-success mt-1">@Model.DeliveredShipmentsCount</div>
                </div>
                <span class="material-symbols-outlined text-success" style="font-size: 36px;">task_alt</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat p-3 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted fw-semibold">Toplam Gönderim</div>
                    <div class="fs-2 fw-bold text-primary mt-1">@Model.TotalShipmentsCount</div>
                </div>
                <span class="material-symbols-outlined text-primary" style="font-size: 36px;">inventory_2</span>
            </div>
        </div>
    </div>
</div>

@model UserDashboardDto
@{
    ViewData["Title"] = "Kargolarım Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Hoş Geldiniz, @Model.UserFullName</h2>
        <p class="text-muted small mb-0">Adınıza gelen ve gönderdiğiniz tüm kargoların güncel hareketlerini buradan izleyebilirsiniz.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/User/Shipment/SendCargo" class="btn btn-primary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">send</span>
            Yeni Kargo Gönder
        </a>
        <a href="/User/Shipment/CalculatePrice" class="btn btn-outline-secondary d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">calculate</span>
            Fiyat Hesapla
        </a>
    </div>
</div>

<!-- 3 KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-stat p-3 bg-white border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted fw-semibold">Yoldaki / Aktif Kargolarım</div>
                    <div class="fs-2 fw-bold text-dark mt-1">@Model.ActiveShipmentsCount</div>
                </div>
                <span class="material-symbols-outlined text-warning" style="font-size: 36px;">local_shipping</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat p-3 bg-white border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted fw-semibold">Teslim Edilenler</div>
                    <div class="fs-2 fw-bold text-success mt-1">@Model.DeliveredShipmentsCount</div>
                </div>
                <span class="material-symbols-outlined text-success" style="font-size: 36px;">task_alt</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-stat p-3 bg-white border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted fw-semibold">Toplam Gönderim</div>
                    <div class="fs-2 fw-bold text-primary mt-1">@Model.TotalShipmentsCount</div>
                </div>
                <span class="material-symbols-outlined text-primary" style="font-size: 36px;">inventory_2</span>
            </div>
        </div>
    </div>
</div>

<!-- Active Cargos Table -->
<div class="card card-stat bg-white p-4 mb-4">
    <h5 class="fw-bold mb-3 border-bottom pb-2">Aktif / Taşımadaki Gönderilerim</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Takip No</th>
                    <th>Alıcı</th>
                    <th>Varış Şubesi</th>
                    <th>Durum</th>
                    <th>Tahmini Teslimat</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ActiveCargos != null && Model.ActiveCargos.Any())
                {
                    @foreach (var c in Model.ActiveCargos)
                    {
                        <tr>
                            <td class="fw-bold font-monospace text-primary">@c.TrackCode</td>
                            <td>@c.ReceiverName</td>
                            <td>@c.DestinationBranchName</td>
                            <td>
                                <span class="badge @(c.CargoStatus == CargoStatus.OutForDelivery ? "bg-warning text-dark" : "bg-primary")">
                                    @CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(c.CargoStatus)
                                </span>
                            </td>
                            <td>@c.EstimatedDeliveryDate.ToString("dd MMMM yyyy")</td>
                            <td class="text-end">
                                <a href="/Default/CargoDetails?trackCode=@c.TrackCode" class="btn btn-sm btn-outline-primary" target="_blank">
                                    Detaylı Takip &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Şu an aktif veya taşımada olan bir kargonuz bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card card-stat bg-white p-4 mb-4">
    <h5 class="fw-bold mb-3 border-bottom pb-2">Son Kargo Hareketleri</h5>
    @if (Model.RecentMovements.Any())
    {
        <div class="timeline">
            @foreach (var movement in Model.RecentMovements)
            {
                <div class="border-start border-3 border-info ps-3 pb-3">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <span class="fw-semibold font-monospace text-primary">@movement.TrackCode</span>
                            <span class="text-muted">- @movement.Description</span>
                        </div>
                        <span class="text-muted small text-nowrap">@movement.Timestamp.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <div class="small text-muted">@movement.LocationName</div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted small mb-0">Henüz görüntülenecek bir kargo hareketi bulunmuyor.</p>
    }
</div>

<!-- Past Delivered Shipments -->
<div class="card card-stat bg-white p-4">
    <h5 class="fw-bold mb-3 border-bottom pb-2">Geçmiş Teslimatlar</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Takip No</th>
                    <th>Alıcı</th>
                    <th>Durum</th>
                    <th>Teslim Tarihi</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PastCargos != null && Model.PastCargos.Any())
                {
                    @foreach (var c in Model.PastCargos)
                    {
                        <tr>
                            <td class="fw-bold font-monospace">@c.TrackCode</td>
                            <td>@c.ReceiverName</td>
                            <td>
                                <span class="badge @(c.CargoStatus == CargoStatus.Delivered ? "bg-success" : "bg-secondary")">
                                    @CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(c.CargoStatus)
                                </span>
                            </td>
                            <td>@(c.ArrivalDate?.ToString("dd MMMM yyyy") ?? "-")</td>
                            <td class="text-end">
                                <a href="/Default/CargoDetails?trackCode=@c.TrackCode" class="btn btn-sm btn-light border" target="_blank">
                                    Görüntüle
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Geçmiş teslimat kaydınız bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

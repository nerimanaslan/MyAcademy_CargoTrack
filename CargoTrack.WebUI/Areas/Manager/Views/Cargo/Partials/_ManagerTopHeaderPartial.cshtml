@{
    string branchName = ViewBag.BranchName as string ?? "Kadıköy Şubesi";
    string search = ViewBag.CurrentSearch ?? "";
}

<header class="bg-[#0b1224] border-b border-telemetry-border px-5 py-2.5 flex-none z-30 shadow-lg">
    <div class="flex items-center justify-between gap-4">
        <!-- Brand & Hub Identity -->
        <div class="flex items-center space-x-3.5">
            <a href="/Manager/Dashboard/Index" class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-cyan-400 p-[1px] shadow-glow-blue hover:scale-105 transition">
                <div class="w-full h-full bg-[#0b1224] rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </div>
            </a>
            <div>
                <div class="flex items-center space-x-2">
                    <span class="text-lg font-black tracking-wider text-white">Cargo<span class="text-cyan-400">Track</span></span>
                    <span class="px-2 py-0.5 text-[10px] font-semibold bg-blue-950/80 border border-blue-500/40 text-blue-300 rounded-md">V4.8 ENTERPRISE</span>
                </div>
                <p class="text-xs text-telemetry-muted font-medium flex items-center gap-1.5">
                    <span>Şube Operasyon Paneli</span>
                    <span class="text-slate-600">•</span>
                    <span class="text-slate-300 font-semibold flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 text-amber-400 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
                        @branchName
                    </span>
                </p>
            </div>
        </div>

        <!-- Live Search Bar -->
        <form method="get" class="flex-1 max-w-xl mx-4 hidden lg:block">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </div>
                <input name="search" value="@search" class="w-full bg-[#060b17] border border-telemetry-border text-sm text-slate-200 placeholder-slate-500 rounded-lg pl-10 pr-20 py-2 focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 focus:outline-none transition" placeholder="Takip No (MYC-2026-...), Alıcı, veya Kurye ara..." type="text" />
                <button type="submit" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-cyan-400 font-semibold px-2 hover:text-white">Ara</button>
            </div>
        </form>

        <!-- Action Cluster & User Badge -->
        <div class="flex items-center space-x-3">
            <a href="/Manager/Dashboard/Index" class="hidden md:flex items-center space-x-1.5 px-3 py-1.5 bg-blue-600/20 hover:bg-blue-600/30 text-blue-300 border border-blue-500/40 rounded-lg text-xs font-semibold transition active:scale-95">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                <span>Şube Dashboard</span>
            </a>
            <a href="/Manager/Cargo/OutForDelivery" class="flex items-center space-x-1.5 px-3.5 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-lg text-xs font-bold transition shadow-glow-amber active:scale-95">
                <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2"></path>
                </svg>
                <span>Dağıtım Listesi &amp; Kod Doğrulama</span>
            </a>
            <div class="h-6 w-[1px] bg-telemetry-border mx-1"></div>
            <!-- Telemetry Sync Status -->
            <div class="hidden sm:flex items-center space-x-2 bg-[#060b17] border border-telemetry-border px-2.5 py-1.5 rounded-lg">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-[11px] font-mono text-emerald-400 font-medium">1.2s • Canlı</span>
            </div>
            <!-- User Profile Pill -->
            <div class="flex items-center space-x-2.5 bg-telemetry-card border border-telemetry-border px-3 py-1.5 rounded-lg">
                <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-bold text-xs text-white">
                    @(User.Identity?.Name != null && User.Identity.Name.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "MD")
                </div>
                <div class="text-left hidden xl:block">
                    <div class="text-xs font-bold text-slate-100 leading-tight">@(User.Identity?.Name ?? "Şube Müdürü")</div>
                    <div class="text-[10px] text-cyan-400 font-mono">Yetkili Müdür</div>
                </div>
                <a href="/Login/Logout" class="text-slate-400 hover:text-rose-400 p-1 transition ml-1" title="Çıkış Yap">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</header>

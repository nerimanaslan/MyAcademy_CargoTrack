@using CargoTrack.DTO.DTOs.Cargos
@model ResultCargoDto

@{
    string branchName = ViewBag.BranchName as string ?? "Kadıköy Şubesi";
}

<!-- Focused Header & Stage Stepper -->
<div class="p-5 border-b border-telemetry-border bg-[#0d162a]">
    <div class="flex items-start justify-between">
        <div>
            <div class="flex items-center space-x-2">
                <span id="focusedStatusBadge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
                    @(Model != null ? CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(Model.CargoStatus) : "SEÇİM BEKLENİYOR")
                </span>
                <span class="text-xs font-mono text-cyan-400" id="focusedEta">ETA: Aktif Rota</span>
            </div>
            <h2 id="focusedTrackCode" class="text-lg font-extrabold text-white font-mono mt-1 flex items-center gap-2">
                @(Model?.TrackCode ?? "MYC-2026-XXXXXX")
            </h2>
            <p id="focusedDateInfo" class="text-xs text-slate-400 mt-0.5">
                @(Model != null ? $"Gönderim: {Model.ShipmentDate:dd.MM.yyyy HH:mm} • Standart Kargo" : "Kargo seçildiğinde detaylar güncellenir")
            </p>
        </div>
        <div class="text-right">
            <span class="text-xs text-slate-400 block">Kargo Ücreti</span>
            <span id="focusedPrice" class="text-base font-bold text-emerald-400 font-mono">₺@(Model?.Price.ToString("N2") ?? "0,00")</span>
        </div>
    </div>

    <!-- 6-Stage Tracking Stepper -->
    <div class="mt-5 pt-3 border-t border-telemetry-border/70">
        <div class="flex items-center justify-between relative">
            <div class="absolute left-3 right-3 top-3 h-0.5 bg-slate-800 -z-0"></div>
            <div id="stepperProgressBar" class="absolute left-3 w-[80%] top-3 h-0.5 bg-gradient-to-r from-emerald-500 via-blue-500 to-amber-400 -z-0 transition-all duration-500"></div>
            
            <div class="flex flex-col items-center relative z-10" id="step1">
                <div class="w-6 h-6 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center text-xs font-bold shadow-glow-emerald">✓</div>
                <span class="text-[9px] font-semibold text-slate-300 mt-1">Kayıt</span>
            </div>
            <div class="flex flex-col items-center relative z-10" id="step2">
                <div class="w-6 h-6 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center text-xs font-bold shadow-glow-emerald">✓</div>
                <span class="text-[9px] font-semibold text-slate-300 mt-1">Çıkış</span>
            </div>
            <div class="flex flex-col items-center relative z-10" id="step3">
                <div class="w-6 h-6 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center text-xs font-bold shadow-glow-emerald">✓</div>
                <span class="text-[9px] font-semibold text-slate-300 mt-1">Transfer</span>
            </div>
            <div class="flex flex-col items-center relative z-10" id="step4">
                <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center text-xs font-bold shadow-glow-blue">✓</div>
                <span class="text-[9px] font-semibold text-cyan-300 mt-1">Varış</span>
            </div>
            <div class="flex flex-col items-center relative z-10" id="step5">
                <div class="w-6 h-6 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center text-xs font-bold ring-4 ring-amber-400/20 shadow-glow-amber animate-pulse">●</div>
                <span class="text-[9px] font-bold text-amber-300 mt-1">Kuryede</span>
            </div>
            <div class="flex flex-col items-center relative z-10" id="step6">
                <div class="w-6 h-6 rounded-full bg-slate-800 text-slate-500 flex items-center justify-center text-xs font-bold border border-slate-700">6</div>
                <span class="text-[9px] font-semibold text-slate-500 mt-1">Teslimat</span>
            </div>
        </div>
    </div>
</div>

<!-- Live GPS Telemetry Courier Map Visualizer -->
<div class="relative h-48 bg-[#050913] border-b border-telemetry-border overflow-hidden grid-pattern">
    <div class="absolute top-2 left-3 z-10 flex items-center space-x-2 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded border border-telemetry-border text-[10px] font-mono text-cyan-300">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        <span id="mapRouteHeader">GPS CANLI TELEMETRİ • @branchName</span>
    </div>
    <div class="absolute bottom-2 left-3 z-10 text-[10px] font-mono text-slate-400 bg-slate-950/80 px-2 py-0.5 rounded border border-telemetry-border">
        Araç: 34-TK-8924 (Ford Transit) | Hız: 32 km/s
    </div>

    <!-- Simulated Vector Map Polyline Overlay -->
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <path d="M 40 160 Q 120 120 180 130 T 290 85 T 390 60" fill="none" stroke="#1e2f58" stroke-linecap="round" stroke-width="6"></path>
        <path d="M 40 160 Q 120 120 180 130 T 290 85 T 390 60" fill="none" stroke="#0ea5e9" stroke-dasharray="6,4" stroke-linecap="round" stroke-width="2.5"></path>
        <!-- Origin Hub Marker -->
        <circle cx="40" cy="160" fill="#3b82f6" r="6"></circle>
        <circle cx="40" cy="160" fill="none" opacity="0.6" r="12" stroke="#3b82f6" stroke-width="1.5"></circle>
        <!-- Destination Marker -->
        <circle cx="390" cy="60" fill="#ef4444" r="7"></circle>
        <circle cx="390" cy="60" fill="none" opacity="0.5" r="14" stroke="#ef4444" stroke-width="1.5"></circle>
    </svg>

    <!-- Dynamic Courier Pin (Animated radar waves) -->
    <div class="absolute top-[80px] left-[285px] -translate-x-1/2 -translate-y-1/2 flex items-center justify-center">
        <span class="w-10 h-10 rounded-full bg-amber-400/30 absolute pulse-ring"></span>
        <div class="w-8 h-8 rounded-full bg-amber-500 text-slate-950 font-bold text-[10px] flex items-center justify-center shadow-glow-amber border-2 border-white z-10">
            🚚
        </div>
        <div class="absolute top-9 left-1/2 -translate-x-1/2 whitespace-nowrap bg-slate-900 border border-amber-400/50 text-amber-300 text-[10px] font-mono px-2 py-0.5 rounded shadow-lg">
            Kurye: Sahada (Yaklaşıyor)
        </div>
    </div>

    <!-- Recipient Pin Label -->
    <div class="absolute top-[42px] right-3 text-[10px] font-semibold bg-rose-950/90 border border-rose-500/50 text-rose-200 px-2 py-0.5 rounded" id="mapRecipientTag">
        Alıcı: @(Model?.ReceiverName ?? "Alıcı")
    </div>
</div>

@model List<ResultCargoDto>
@{
    ViewData["Title"] = "Dağıtım Listesi & Teslimat Kodu Doğrulama";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Dağıtım Listesi & Teslimat Kodu Doğrulama</h2>
        <p class="text-muted small mb-0">Sahada dağıtımda olan kargolar için 6 haneli güvenlik kodu ile teslimat veya istisna kaydı</p>
    </div>
    <a href="/Manager/Cargo/Index" class="btn btn-outline-secondary">&larr; Tüm Şube Kargoları</a>
</div>

<div class="card card-stat bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Takip No</th>
                    <th>Alıcı Bilgileri</th>
                    <th>Teslimat Adresi</th>
                    <th>Süreç</th>
                    <th>Güvenlik Kodu (Demo Amaçlı)</th>
                    <th class="text-end">Operasyonel İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold font-monospace">@c.TrackCode</td>
                            <td>
                                <div class="fw-semibold">@c.ReceiverName</div>
                                <div class="text-muted small">@c.ReceiverPhone</div>
                            </td>
                            <td class="small" style="max-width: 250px;">@c.ReceiverAddress</td>
                            <td>
                                <span class="badge bg-warning text-dark">Dağıtıma Çıktı</span>
                                @if (c.FailedDeliveryAttempts > 0)
                                {
                                    <span class="badge bg-danger d-block mt-1">Deneme: @c.FailedDeliveryAttempts/3</span>
                                }
                            </td>
                            <td>
                                <div class="badge bg-light text-dark border font-monospace fs-6 px-2 py-1">
                                    @(c.DeliveryPinCode ?? "KOD ÜRETİLMEDİ")
                                </div>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#deliverModal-@c.Id">
                                    <span class="material-symbols-outlined fs-6">verified</span>
                                    Kodu Doğrula & Teslim Et
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 ms-1" data-bs-toggle="modal" data-bs-target="#exceptionModal-@c.Id">
                                    <span class="material-symbols-outlined fs-6">report_problem</span>
                                    Teslim Edilemedi
                                </button>
                            </td>
                        </tr>

                        <!-- Delivery Modal -->
                        <div class="modal fade" id="deliverModal-@c.Id" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <form asp-action="VerifyDelivery" method="post">
                                        <div class="modal-header bg-success text-white">
                                            <h5 class="modal-title fs-6">Teslimat Doğrulama - @c.TrackCode</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="hidden" name="CargoId" value="@c.Id" />

                                            <div class="alert alert-info py-2 small">
                                                Alıcının telefonuna SMS ile iletilen <strong>6 haneli güvenlik kodunu</strong> giriniz. Doğrulama başarılı olmadan kargo teslim edilemez.
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">6 Haneli Teslimat Kodu</label>
                                                <input type="text" name="DeliveryCode" class="form-control form-control-lg text-center font-monospace tracking-widest fw-bold" placeholder="______" maxlength="6" minlength="6" inputmode="numeric" pattern="[0-9]{6}" required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Teslim Alan Kişi</label>
                                                <input type="text" name="ReceivedBy" class="form-control" value="@c.ReceiverName" required />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Alıcıya Yakınlık Derecesi</label>
                                                <select name="ReceiverRelationship" class="form-select">
                                                    <option value="Kendisi">Kendisi</option>
                                                    <option value="Aile Bireyi">Aile Bireyi</option>
                                                    <option value="İş Arkadaşı / Sekreter">İş Arkadaşı / Sekreter</option>
                                                    <option value="Site Güvenliği / Komşu">Site Güvenliği / Komşu</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Teslim Eden Personel</label>
                                                <select name="EmployeeId" asp-items="ViewBag.Employees" class="form-select">
                                                    <option value="">-- Personel Seçin --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                            <button type="submit" class="btn btn-success">Kodu Onayla ve Teslimatı Bitir</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Exception Modal -->
                        <div class="modal fade" id="exceptionModal-@c.Id" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <form asp-action="RecordException" method="post">
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title fs-6">Teslim Edilemedi Kaydı - @c.TrackCode</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="hidden" name="CargoId" value="@c.Id" />

                                            <div class="alert alert-warning py-2 small">
                                                Kargo teslim edilemediğinde gerekçe belirtilmelidir. <strong>3 başarısız deneme</strong> sonunda kargo otomatik olarak <strong>İade Sürecine</strong> alınacaktır.
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Hata / İstisna Sebebi</label>
                                                <select name="Reason" class="form-select" required>
                                                    <option value="Adres Hatalı / Yetersiz">Adres Hatalı / Yetersiz</option>
                                                    <option value="Alıcı Adreste Bulunamadı">Alıcı Adreste Bulunamadı (Evde Yok)</option>
                                                    <option value="Alıcı Kargoyu Kabul Etmedi (Reddetti)">Alıcı Kargoyu Kabul Etmedi (Reddetti)</option>
                                                    <option value="Hasarlı Kargo Tespiti">Hasarlı Kargo Tespiti</option>
                                                    <option value="Ulaşım / Hava Muhalefeti Engeli">Ulaşım / Hava Muhalefeti Engeli</option>
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Operasyon Notu</label>
                                                <textarea name="Notes" class="form-control" rows="2" placeholder="Kurye saha notu..."></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Kurye / Personel</label>
                                                <select name="EmployeeId" asp-items="ViewBag.Employees" class="form-select">
                                                    <option value="">-- Personel Seçin --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                                            <button type="submit" class="btn btn-danger">Hata Kaydını İşle</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Şubenizde şu an dağıtımda olan kargo bulunmamaktadır.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model CargoDetailDto
@{
    ViewData["Title"] = "Şube Kargo Detayı - " + Model.TrackCode;
    var nextStatuses = new List<CargoStatus>();

    if (Model.CargoStatus == CargoStatus.Created)
    {
        nextStatuses.Add(CargoStatus.AtOriginBranch);
    }
    else if (Model.CargoStatus == CargoStatus.AtOriginBranch)
    {
        nextStatuses.Add(CargoStatus.InTransferCenter);
        nextStatuses.Add(CargoStatus.AtDestinationBranch);
    }
    else if (Model.CargoStatus == CargoStatus.InTransferCenter)
    {
        nextStatuses.Add(CargoStatus.AtDestinationBranch);
    }
    else if (Model.CargoStatus == CargoStatus.AtDestinationBranch)
    {
        nextStatuses.Add(CargoStatus.OutForDelivery);
    }
    else if (Model.CargoStatus == CargoStatus.DeliveryFailed)
    {
        nextStatuses.Add(CargoStatus.OutForDelivery);
    }
    else if (Model.CargoStatus == CargoStatus.ReturnProcess)
    {
        nextStatuses.Add(CargoStatus.ReturnedToSender);
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="h3 fw-bold mb-0 font-monospace">@Model.TrackCode</h2>
            <span class="badge @(Model.CargoStatus == CargoStatus.Delivered ? "bg-success" : Model.CargoStatus == CargoStatus.OutForDelivery ? "bg-warning text-dark" : Model.CargoStatus == CargoStatus.DeliveryFailed ? "bg-danger" : "bg-primary") fs-6">
                @CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(Model.CargoStatus)
            </span>
        </div>
        <p class="text-muted small mt-1 mb-0">Gönderim Tarihi: @Model.ShipmentDate.ToString("dd.MM.yyyy HH:mm")</p>
    </div>
    <a href="/Manager/Cargo/Index" class="btn btn-outline-secondary">&larr; Şube Kargolarına Dön</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card card-stat bg-white p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Kargo Bilgileri</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border">
                        <div class="text-muted small">Alıcı:</div>
                        <div class="fw-bold">@Model.ReceiverName</div>
                        <div class="small text-muted">@Model.ReceiverPhone</div>
                        <div class="small text-muted mt-1">@Model.ReceiverAddress</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border">
                        <div class="text-muted small">Güzergah:</div>
                        <div class="fw-bold">@Model.OriginBranchName &rarr; @Model.DestinationBranchName</div>
                        <div class="small text-muted mt-1">Paket: @Model.Weight kg / @Model.Desi desi</div>
                        <div class="small text-success fw-bold mt-1">Ücret: @Model.Price.ToString("C2")</div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.DeliveryPinCode))
            {
                <div class="mt-3 p-3 bg-warning bg-opacity-10 border border-warning rounded d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-warning text-dark me-2">Teslimat Güvenlik Kodu</span>
                        <span class="fs-4 fw-bold font-monospace text-dark tracking-widest">@Model.DeliveryPinCode</span>
                    </div>
                    <a href="/Manager/Cargo/OutForDelivery" class="btn btn-sm btn-dark">Doğrulama Ekranı</a>
                </div>
            }
        </div>

        <div class="card card-stat bg-white p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Şube Operasyonel Durum Güncellemesi</h5>
            @if (nextStatuses.Any())
            {
                <form asp-action="UpdateStatus" method="post" class="row g-3">
                    <input type="hidden" name="CargoId" value="@Model.Id" />
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Sonraki İşlem</label>
                        <select name="NewStatus" class="form-select" required>
                            @foreach (var status in nextStatuses)
                            {
                                <option value="@status">@CargoTrack.Business.Services.Cargos.CargoService.GetStatusDisplayName(status)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Personel</label>
                        <select name="EmployeeId" asp-items="ViewBag.Employees" class="form-select">
                            <option value="">-- Personel Seçin --</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama / Not</label>
                        <input type="text" name="Description" class="form-control" placeholder="Operasyon açıklaması" />
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">İşlemi Kaydet</button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    Bu kargo için yapılacak yeni şube işlemi bulunmuyor.
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-stat bg-white p-4 h-100">
            <h5 class="fw-bold mb-3 border-bottom pb-2">Kargo Hareket Geçmişi</h5>
            <div class="timeline">
                @if (Model.Movements != null && Model.Movements.Any())
                {
                    @foreach (var m in Model.Movements)
                    {
                        <div class="border-start border-3 border-info ps-3 pb-3 position-relative">
                            <div class="small fw-semibold text-dark">@m.Description</div>
                            <div class="text-muted" style="font-size: 11px;">
                                @m.LocationName • @m.Timestamp.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Şube Yönetimi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .sidebar { min-height: 100vh; background-color: #1e293b; color: #fff; }
        .sidebar a { color: #94a3b8; text-decoration: none; padding: 10px 16px; display: flex; align-items: center; gap: 10px; border-radius: 6px; margin: 3px 8px; font-size: 14px; font-weight: 500; transition: all 0.2s; }
        .sidebar a:hover, .sidebar a.active { background-color: #334155; color: #ffffff; }
        .sidebar .sidebar-heading { font-size: 11px; text-transform: uppercase; color: #64748b; padding: 12px 18px 4px; font-weight: 700; letter-spacing: 0.5px; }
        .main-content { min-height: 100vh; display: flex; flex-direction: column; }
        .topbar { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
        .material-symbols-outlined { font-size: 20px; }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar d-none d-md-block">
                <div class="p-3 border-bottom border-secondary d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-warning" style="font-size: 28px;">local_shipping</span>
                    <div>
                        <div class="fw-bold fs-5 text-white">CargoTrack</div>
                        <div class="text-secondary small" style="font-size: 11px;">Şube Operasyon Paneli</div>
                    </div>
                </div>

                <div class="sidebar-heading">Şube Operasyonları</div>
                <a href="/Manager/Dashboard/Index">
                    <span class="material-symbols-outlined">dashboard</span>
                    Şube Dashboard
                </a>
                <a href="/Manager/Cargo/Index">
                    <span class="material-symbols-outlined">inventory_2</span>
                    Şube Kargoları
                </a>
                <a href="/Manager/Cargo/OutForDelivery">
                    <span class="material-symbols-outlined">verified_user</span>
                    Teslimat Kodu Doğrulama
                </a>

                <div class="sidebar-heading">İşlemler</div>
                <a href="/Manager/Cargo/Index?status=AtDestinationBranch">
                    <span class="material-symbols-outlined">departure_board</span>
                    Dağıtıma Çıkar
                </a>
                <a href="/Manager/Cargo/Index?status=DeliveryFailed">
                    <span class="material-symbols-outlined">warning</span>
                    Sorunlu Kargolar
                </a>

                <hr class="border-secondary mx-3 my-2" />
                <a href="/Default/Index" target="_blank">
                    <span class="material-symbols-outlined">open_in_new</span>
                    Kargo Takip Ekranı
                </a>
                <a href="/Login/Logout" class="text-danger">
                    <span class="material-symbols-outlined">logout</span>
                    Çıkış Yap
                </a>
            </div>

            <!-- Content Area -->
            <div class="col-md-9 col-lg-10 main-content">
                <header class="topbar">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">Şube Yöneticisi</span>
                        <span class="text-muted small">| Hoş geldiniz, <strong>@User.Identity?.Name</strong></span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <a href="/Default/Index" class="btn btn-sm btn-outline-primary">Takip Ekranı</a>
                        <a href="/Login/Logout" class="btn btn-sm btn-outline-danger">Çıkış</a>
                    </div>
                </header>

                <main class="p-4 flex-grow-1">
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                            <span class="material-symbols-outlined align-middle me-1">check_circle</span>
                            @TempData["success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <span class="material-symbols-outlined align-middle me-1">error</span>
                            @TempData["error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <footer class="bg-white border-top p-3 text-center text-muted small">
                    CargoTrack Case Study • Şube Operasyon Paneli © 2026
                </footer>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
